client
dev tun
proto udp
remote hybrid-vpn.example.com 1194
remote-cert-tls server
verb 3
auth-user-pass old-auth.txt
<ca>
-----BEGIN CERTIFICATE-----
REDACTED_CA
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
REDACTED_CLIENT_CERT
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
REDACTED_PRIVATE_KEY
-----END PRIVATE KEY-----
</key>
