# OpenStream example: certificate-only / TLS mutual-auth OpenVPN profile
# This file is safe to publish. All certificate material is redacted.

client
dev tun
proto tcp-client
remote cert-vpn.example.com 443
nobind
persist-key
persist-tun
remote-cert-tls server
verb 3

# Certificate-only profiles must not be forced to use auth-user-pass.
<ca>
-----BEGIN CERTIFICATE-----
REDACTED_EXAMPLE_CA_CERTIFICATE
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
REDACTED_EXAMPLE_CLIENT_CERTIFICATE
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
REDACTED_EXAMPLE_PRIVATE_KEY_DO_NOT_USE
-----END PRIVATE KEY-----
</key>
