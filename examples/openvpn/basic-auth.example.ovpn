# OpenStream example: username/password OpenVPN profile
# This file is safe to publish. It uses fake hosts and placeholder values only.
# Put real provider .ovpn files in ~/Desktop/opst, not in this directory.

client
dev tun
proto udp
remote vpn.example.com 1194
remote-random
nobind
persist-key
persist-tun
remote-cert-tls server
verb 3
cipher AES-128-CBC

# OpenStream replaces this with a profile-specific file under:
# /etc/openvpn/opst/auth/<profile-id>.txt
auth-user-pass

<ca>
-----BEGIN CERTIFICATE-----
REDACTED_EXAMPLE_CA_CERTIFICATE
-----END CERTIFICATE-----
</ca>
