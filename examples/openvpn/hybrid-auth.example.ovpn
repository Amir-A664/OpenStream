# OpenStream example: hybrid username/password + certificate OpenVPN profile
# This file is safe to publish. It contains no real server or real secret.

client
dev tun
proto udp
remote hybrid-vpn.example.com 1194
nobind
persist-key
persist-tun
remote-cert-tls server
verb 3
cipher AES-128-CBC

# OpenStream will replace this with:
# auth-user-pass /etc/openvpn/opst/auth/<profile-id>.txt
auth-user-pass

<ca>
-----BEGIN CERTIFICATE-----
REDACTED_EXAMPLE_CA_CERTIFICATE
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
REDACTED_EXAMPLE_CLIENT_CERTIFICATE
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
REDACTED_EXAMPLE_PRIVATE_KEY_DO_NOT_USE
-----END PRIVATE KEY-----
</key>
