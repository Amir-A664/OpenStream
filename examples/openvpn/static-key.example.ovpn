# OpenStream example: static key / tls-auth style OpenVPN profile
# This file is safe to publish. The tls-auth material is intentionally fake.

client
dev tun
proto udp
remote static-key-vpn.example.com 1194
nobind
persist-key
persist-tun
remote-cert-tls server
verb 3
key-direction 1

<ca>
-----BEGIN CERTIFICATE-----
REDACTED_EXAMPLE_CA_CERTIFICATE
-----END CERTIFICATE-----
</ca>

<tls-auth>
-----BEGIN OpenVPN Static key V1-----
REDACTED_EXAMPLE_STATIC_KEY_DO_NOT_USE
-----END OpenVPN Static key V1-----
</tls-auth>
